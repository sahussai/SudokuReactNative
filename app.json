{
  "expo": {
    "name": "Sudoku",
    "slug": "react-native-course",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/background_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/title2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myApp.playSudoku"
    },
    "android": {
      "icon": "./assets/background_icon.png",
      "edgeToEdgeEnabled": true,
      "package": "com.abeer.hussain94.reactnativecourse"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableForceDarkOnLightThemes": false
          }
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "53e5048c-1b3d-4063-89f5-7b79cd98f7d4"
      }
    },
    "owner": "syedzz"
  }
}
